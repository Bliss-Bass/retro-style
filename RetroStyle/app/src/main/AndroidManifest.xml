<?xml version="1.0" encoding="utf-8"?>
<!--
    RetroStyle: Settings > System > UI style, and the code that applies it.

    Runs as the system user (sharedUserId android.uid.system), so it must be signed with the
    platform key (Android.bp: certificate: "platform"). The permissions below are signature or
    privileged permissions that platform-signed apps get; privapp-permissions-org.retro.style.xml
    lists them for the privileged-permission allowlist.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.retro.style"
    android:sharedUserId="android.uid.system">

    <!-- Store the choices and the applied style in Settings.Secure. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Switch the style's runtime resource overlays (OverlayManager). -->
    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    <!-- Restart SystemUI and the launcher (ActivityManager.killUid). -->
    <uses-permission android:name="android.permission.KILL_UID" />
    <!-- See other apps' desktop windows to reopen them after a SystemUI restart. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Packs may force dark or light mode (UiModeManager.setNightMode). -->
    <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" />
    <!-- LineageOS's black theme lives in its own settings provider, which checks
         lineageos.permission.WRITE_SECURE_SETTINGS. The system user passes that check, so the
         app doesn't request it (the permission doesn't exist outside LineageOS). -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_retro_style_settings"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RetroStyle">

        <!-- Shown as a tile in Settings > System through the EXTRA_SETTINGS injection. -->
        <activity
            android:name=".StyleActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/app_name" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/app_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_retro_style_settings" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- For scripts and tests; only callers with WRITE_SECURE_SETTINGS may send it. -->
        <receiver
            android:name=".ApplyReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="org.retro.style.action.APPLY" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SetupCompleteJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
