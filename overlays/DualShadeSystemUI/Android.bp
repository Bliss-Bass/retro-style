package {
    default_applicable_licenses: ["vendor_retro-style_license"],
}

// Static SystemUI config for Dual Shade on large screens: desktop status bar, notifications on the end side, Quick Settings volume slider. Always on.
runtime_resource_overlay {
    name: "RetroStyleDualShadeSystemUI",
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    // Installed to /product/overlay. Overlays on /product may replace resources of targets
    // that declare no <overlayable>, which is the case for framework-res, SystemUI, Settings
    // and Launcher3.
    product_specific: true,
}
