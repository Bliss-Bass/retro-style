package {
    default_applicable_licenses: ["vendor_retro-style_aosp_assets_license"],
}

// Icon pack for SystemUI nav glyphs (category android.theme.customization.icon_pack.systemui), applied by SystemUI from the theme JSON.
runtime_resource_overlay {
    name: "RetroStyleKitKatIconsSystemUI",
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    // Installed to /product/overlay. Overlays on /product may replace resources of targets
    // that declare no <overlayable>, which is the case for framework-res, SystemUI, Settings
    // and Launcher3.
    product_specific: true,
}
