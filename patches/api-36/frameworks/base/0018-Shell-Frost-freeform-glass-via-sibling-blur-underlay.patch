diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiGlassBlurUnderlay.java b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiGlassBlurUnderlay.java
new file mode 100644
index 000000000000..f3f89254c481
--- /dev/null
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiGlassBlurUnderlay.java
@@ -0,0 +1,103 @@
+/*
+ * Copyright (C) 2026 Navotpala Tech (Bliss Co-Labs Inc.)
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Navotpala-Commercial
+ * Part of retro-style (vendor/retro-style).
