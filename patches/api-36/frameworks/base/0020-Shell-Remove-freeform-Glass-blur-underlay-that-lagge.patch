From e217d9e59a6cc1f6df6f9625b45a0f35b0ec21c3 Mon Sep 17 00:00:00 2001
From: electrikjesus <electrikjesus@gmail.com>
Date: Fri, 27 Nov 2026 22:45:06 +0100
Subject: [PATCH] Shell: Remove freeform Glass blur underlay that lagged as a
 black fill.

The sibling color layer did not track drag and ignored leash alpha; restore
focus-split backgroundBlurRadius on the task leash instead.
---
 .../windowdecor/DefaultWindowDecoration.kt    |  34 ------
 .../DesktopModeWindowDecoration.java          |  32 ------
 .../windowdecor/RetroUiGlassBlurUnderlay.java | 103 ------------------
 .../shell/windowdecor/RetroUiWindowStyle.java |  15 ++-
 4 files changed, 7 insertions(+), 177 deletions(-)
 delete mode 100644 libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiGlassBlurUnderlay.java

diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/DefaultWindowDecoration.kt b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/DefaultWindowDecoration.kt
index 781b96561c5c..6f14a8343f79 100644
--- a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/DefaultWindowDecoration.kt
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/DefaultWindowDecoration.kt
@@ -189,7 +189,6 @@ constructor(
     private val taskPositionInParent = Point()
     private var dragResizeListener: DragResizeInputListener? = null
     private var resizeVeil: ResizeVeil? = null
-    private var glassBlurUnderlay: RetroUiGlassBlurUnderlay? = null
     private var openByDefaultFirstRunPrompt: OpenByDefaultFirstRunPrompt? = null
     private val isOpenByDefaultFirstRunPromptActive
         get() = openByDefaultFirstRunPrompt != null
@@ -501,37 +500,6 @@ constructor(
             clear.apply()
             finishT?.unsetColor(taskSurface)
         }
-        applyGlassBlurUnderlay(taskSurface, hasGlobalFocus, pkg)
-    }
-
-    private fun applyGlassBlurUnderlay(
-        taskSurface: SurfaceControl,
-        hasGlobalFocus: Boolean,
-        pkg: String?,
-    ) {
-        if (
-            !taskInfo.isFreeform ||
-                RetroUiWindowStyle.isAlphaDenied(context, pkg) ||
-                !RetroUiWindowStyle.isGlassEnabled(context)
-        ) {
-            glassBlurUnderlay?.hide()
-            return
-        }
-        val underlay =
-            glassBlurUnderlay
-                ?: RetroUiGlassBlurUnderlay(
-                        taskInfo.taskId,
-                        surfaceControlBuilderSupplier,
-                        surfaceControlTransactionSupplier,
-                    )
-                    .also { glassBlurUnderlay = it }
-        val bounds = Rect(taskInfo.configuration.windowConfiguration.bounds)
-        underlay.apply(
-            taskSurface,
-            bounds,
-            RetroUiWindowStyle.blurRadiusPx(context, hasGlobalFocus),
-            /* cornerRadius= */ 0f,
-        )
     }
 
     /**
@@ -1136,8 +1104,6 @@ constructor(
         taskResourceLoader.onWindowDecorClosed(taskInfo)
         closeDragResizeListener()
         disposeResizeVeil()
-        glassBlurUnderlay?.release()
-        glassBlurUnderlay = null
         exclusionRegionListener.onExclusionRegionDismissed(taskInfo.taskId)
         super.close()
     }
diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/DesktopModeWindowDecoration.java b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/DesktopModeWindowDecoration.java
index ea73343d1663..e668843bf1d6 100644
--- a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/DesktopModeWindowDecoration.java
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/DesktopModeWindowDecoration.java
@@ -198,7 +198,6 @@ public class DesktopModeWindowDecoration extends WindowDecoration<WindowDecorLin
     private OpenByDefaultDialog mOpenByDefaultDialog;
 
     private ResizeVeil mResizeVeil;
-    @Nullable private RetroUiGlassBlurUnderlay mGlassBlurUnderlay;
 
     private CapturedLink mCapturedLink;
     private long mAppToWebEducationRequestTimestamp;
@@ -697,33 +696,6 @@ public class DesktopModeWindowDecoration extends WindowDecoration<WindowDecorLin
                 finishT.unsetColor(taskSurface);
             }
         }
-        applyGlassBlurUnderlay(taskSurface, hasGlobalFocus, pkg);
-    }
-
-    private void applyGlassBlurUnderlay(
-            SurfaceControl taskSurface, boolean hasGlobalFocus, @Nullable String pkg) {
-        if (!mTaskInfo.isFreeform()
-                || RetroUiWindowStyle.isAlphaDenied(mContext, pkg)
-                || !RetroUiWindowStyle.isGlassEnabled(mContext)) {
-            if (mGlassBlurUnderlay != null) {
-                mGlassBlurUnderlay.hide();
-            }
-            return;
-        }
-        if (mGlassBlurUnderlay == null) {
-            mGlassBlurUnderlay =
-                    new RetroUiGlassBlurUnderlay(
-                            mTaskInfo.taskId,
-                            mSurfaceControlBuilderSupplier,
-                            mSurfaceControlTransactionSupplier);
-        }
-        final Rect bounds = new Rect(mTaskInfo.configuration.windowConfiguration.getBounds());
-        final float cornerRadius = mResult != null ? mResult.mCornerRadius : 0f;
-        mGlassBlurUnderlay.apply(
-                taskSurface,
-                bounds,
-                RetroUiWindowStyle.blurRadiusPx(mContext, hasGlobalFocus),
-                cornerRadius);
     }
 
     private boolean isCaptionVisible() {
@@ -2000,10 +1972,6 @@ public class DesktopModeWindowDecoration extends WindowDecoration<WindowDecorLin
         mExclusionRegionListener.onExclusionRegionDismissed(mTaskInfo.taskId);
         disposeResizeVeil();
         disposeStatusBarInputLayer();
-        if (mGlassBlurUnderlay != null) {
-            mGlassBlurUnderlay.release();
-            mGlassBlurUnderlay = null;
-        }
         if (mWindowDecorViewHolder != null) {
             mWindowDecorViewHolder.close();
             mWindowDecorViewHolder = null;
diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiGlassBlurUnderlay.java b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiGlassBlurUnderlay.java
deleted file mode 100644
index f3f89254c481..000000000000
--- a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiGlassBlurUnderlay.java
+++ /dev/null
@@ -1,103 +0,0 @@
-/*
- * Copyright (C) 2026 Navotpala Tech (Bliss Co-Labs Inc.)
- *
- * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Navotpala-Commercial
- * Part of retro-style (vendor/retro-style).
