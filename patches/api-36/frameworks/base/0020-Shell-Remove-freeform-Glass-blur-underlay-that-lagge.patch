-
-package com.android.wm.shell.windowdecor;
-
-import android.graphics.Rect;
-import android.view.SurfaceControl;
-
-import androidx.annotation.Nullable;
-
-import java.util.function.Supplier;
-
-/**
- * Sibling color layer parked just under a freeform task leash so {@code setBackgroundBlurRadius}
- * can frost the wallpaper/windows behind it. Task leash alpha then composites the opaque app
- * buffers over this underlay — leash-only blur is covered by those buffers and never shows.
- */
-final class RetroUiGlassBlurUnderlay {
-    private final Supplier<SurfaceControl.Builder> mBuilderSupplier;
-    private final Supplier<SurfaceControl.Transaction> mTransactionSupplier;
-    private final int mTaskId;
-
-    @Nullable private SurfaceControl mUnderlay;
-
-    RetroUiGlassBlurUnderlay(
-            int taskId,
-            Supplier<SurfaceControl.Builder> builderSupplier,
-            Supplier<SurfaceControl.Transaction> transactionSupplier) {
-        mTaskId = taskId;
-        mBuilderSupplier = builderSupplier;
-        mTransactionSupplier = transactionSupplier;
-    }
-
-    /**
-     * Creates/updates the underlay to match {@code taskBounds} and {@code blurRadiusPx}. Pass
-     * {@code blurRadiusPx <= 0} to hide. {@code relativeToTask} is the freeform task leash.
-     */
-    void apply(
-            @Nullable SurfaceControl relativeToTask,
-            Rect taskBounds,
-            int blurRadiusPx,
-            float cornerRadius) {
-        if (relativeToTask == null || !relativeToTask.isValid() || taskBounds.isEmpty()) {
-            hide();
-            return;
-        }
-        if (blurRadiusPx <= 0) {
-            hide();
-            return;
-        }
-        ensureSurface();
-        if (mUnderlay == null || !mUnderlay.isValid()) {
-            return;
-        }
-        final SurfaceControl.Transaction t = mTransactionSupplier.get();
-        t.setRelativeLayer(mUnderlay, relativeToTask, /* z= */ -1);
-        t.setPosition(mUnderlay, taskBounds.left, taskBounds.top);
-        t.setWindowCrop(mUnderlay, taskBounds.width(), taskBounds.height());
-        t.setCornerRadius(mUnderlay, cornerRadius);
-        t.setBackgroundBlurRadius(mUnderlay, blurRadiusPx);
-        // Fully transparent fill: SF still draws background blur for effect layers.
-        t.setAlpha(mUnderlay, 1f);
-        t.show(mUnderlay);
-        t.apply();
-    }
-
-    void hide() {
-        if (mUnderlay == null || !mUnderlay.isValid()) {
-            return;
-        }
-        final SurfaceControl.Transaction t = mTransactionSupplier.get();
-        t.setBackgroundBlurRadius(mUnderlay, 0);
-        t.hide(mUnderlay);
-        t.apply();
-    }
-
-    void release() {
-        if (mUnderlay == null) {
-            return;
-        }
-        hide();
-        mUnderlay.release();
-        mUnderlay = null;
-    }
-
-    private void ensureSurface() {
-        if (mUnderlay != null && mUnderlay.isValid()) {
-            return;
-        }
-        mUnderlay =
-                mBuilderSupplier
-                        .get()
-                        .setName("Glass blur underlay of Task=" + mTaskId)
-                        .setColorLayer()
-                        .setHidden(true)
-                        .setCallsite("RetroUiGlassBlurUnderlay")
-                        .build();
-    }
-}
diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiWindowStyle.java b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiWindowStyle.java
index 762fbdfbbdda..3f560197af90 100644
--- a/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiWindowStyle.java
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/windowdecor/RetroUiWindowStyle.java
@@ -248,12 +248,11 @@ public final class RetroUiWindowStyle {
     }
 
     /**
-     * Applies RetroStyle window alpha to a freeform task leash.
+     * Applies RetroStyle window blur/alpha to a freeform task leash.
      *
-     * <p>Background blur is drawn on a sibling {@link RetroUiGlassBlurUnderlay} (opaque app
-     * buffers cover leash blur). Alpha uses focused vs unfocused tokens; blocked packages stay
-     * opaque. When blur is on and alpha is unset, a mild default alpha is used so the underlay
-     * frost can show through.
+     * <p>Blur and alpha use focused vs unfocused tokens. Blocked packages stay opaque. When blur
+     * is on and alpha is unset, a mild default alpha is used. Blur is set on the task leash (not a
+     * sibling underlay) so it moves with the window and shares the leash alpha.
      *
      * @param t transaction to mutate (caller applies, or pass a finishT so glass survives
      *     transition end)
@@ -269,16 +268,16 @@ public final class RetroUiWindowStyle {
             return false;
         }
         boolean wrote = false;
-        // Leash blur is a no-op visually under opaque app children; underlay owns frost.
-        t.setBackgroundBlurRadius(taskSurface, 0);
+        final int blurPx = blurRadiusPx(context, hasGlobalFocus);
+        t.setBackgroundBlurRadius(taskSurface, blurPx);
         wrote = true;
 
         if (isAlphaDenied(context, packageName)) {
             t.setAlpha(taskSurface, 1f);
+            t.setBackgroundBlurRadius(taskSurface, 0);
             return wrote;
         }
         float alpha = windowAlpha(context, hasGlobalFocus);
-        final int blurPx = blurRadiusPx(context, hasGlobalFocus);
         if (alpha < 0f && blurPx > 0) {
             alpha = DEFAULT_ALPHA_WITH_BLUR;
         }
