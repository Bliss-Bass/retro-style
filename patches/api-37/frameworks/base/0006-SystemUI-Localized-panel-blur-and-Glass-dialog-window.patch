+/** View-local BackgroundBlurDrawable clipped to the Dual Shade panel bounds. */
+@Composable
+private fun PanelLocalBackgroundBlur(blurRadiusDp: Int, cornerRadius: Dp) {
+    val density = LocalDensity.current
+    val blurRadiusPx = with(density) { blurRadiusDp.dp.roundToPx() }
+    val cornerRadiusPx = with(density) { cornerRadius.toPx() }
+    AndroidView(
+        factory = { context ->
+            View(context).also { view ->
+                view.addOnAttachStateChangeListener(
+                    object : View.OnAttachStateChangeListener {
+                        override fun onViewAttachedToWindow(v: View) {
+                            applyPanelBackgroundBlur(v, blurRadiusPx, cornerRadiusPx)
+                        }
+
+                        override fun onViewDetachedFromWindow(v: View) {
+                            v.background = null
+                        }
+                    }
+                )
+            }
+        },
+        modifier = Modifier.matchParentSize(),
+    )
+}
+
+private fun applyPanelBackgroundBlur(view: View, blurRadiusPx: Int, cornerRadiusPx: Float) {
+    try {
+        val root = view.rootSurfaceControl ?: return
+        val method =
+            try {
+                root.javaClass.getMethod("createBackgroundBlurDrawable")
+            } catch (_: NoSuchMethodException) {
+                root.javaClass.getDeclaredMethod("createBackgroundBlurDrawable").apply {
+                    isAccessible = true
+                }
+            }
+        val drawable = method.invoke(root) as? Drawable ?: return
+        try {
+            drawable.javaClass
+                .getMethod("setBlurRadius", Int::class.javaPrimitiveType)
+                .invoke(drawable, blurRadiusPx)
+        } catch (_: Throwable) {}
+        try {
+            drawable.javaClass
+                .getMethod("setCornerRadius", Float::class.javaPrimitiveType)
+                .invoke(drawable, cornerRadiusPx)
+        } catch (_: Throwable) {}
+        view.background = drawable
+    } catch (t: Throwable) {
+        Log.w("OverlayShade", "panel local blur unavailable", t)
+    }
+}
+
 @Composable
 @ReadOnlyComposable
 @SuppressLint("ConfigurationScreenWidthHeight")
