+package com.android.wm.shell.windowdecor;
+
+import android.content.Context;
+import android.provider.Settings;
+import android.util.DisplayMetrics;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Reads freeform window transparency/blur defaults from RetroStyle's {@code retro_ui_applied}
+ * secure setting (pack defaults + UI Style overrides). Cap concurrent blurs by only applying
+ * when the decoration has global focus.
+ */
+final class RetroUiWindowStyle {
+    private static final String SETTING = "retro_ui_applied";
+    private static final int MAX_BLUR_RADIUS_DP = 40;
+
+    private static Map<String, String> sValues;
+
+    private RetroUiWindowStyle() {}
+
+    static synchronized Map<String, String> values(Context context) {
+        if (sValues == null) {
+            sValues = parse(Settings.Secure.getString(
+                    context.getContentResolver(), SETTING));
+        }
+        return sValues;
+    }
+
+    /** Blur radius in px for the focused freeform task, or 0 when unset/off. */
+    static int blurRadiusPx(Context context) {
+        String raw = values(context).get("window_blur_radius");
+        if (raw == null || raw.isEmpty()) {
+            return 0;
+        }
+        try {
+            int dp = Integer.parseInt(raw);
+            if (dp <= 0) {
+                return 0;
+            }
+            dp = Math.min(dp, MAX_BLUR_RADIUS_DP);
+            DisplayMetrics metrics = context.getResources().getDisplayMetrics();
+            return Math.round(dp * metrics.density);
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    /**
+     * Window alpha 0–1 for the focused freeform task leash, or -1 when unset (leave stock).
+     */
+    static float windowAlpha(Context context) {
+        String raw = values(context).get("window_alpha");
+        if (raw == null || raw.isEmpty()) {
+            return -1f;
+        }
+        try {
+            if (raw.startsWith("#") && raw.length() >= 9) {
+                int argb = (int) Long.parseLong(raw.substring(1), 16);
+                return ((argb >>> 24) & 0xff) / 255f;
+            }
+            int alpha = Integer.parseInt(raw);
+            if (alpha > 255) {
+                return ((alpha >>> 24) & 0xff) / 255f;
+            }
+            return Math.max(0, Math.min(255, alpha)) / 255f;
+        } catch (NumberFormatException e) {
+            return -1f;
+        }
+    }
+
+    static Map<String, String> parse(String value) {
+        if (value == null || value.isEmpty()) {
+            return Collections.emptyMap();
+        }
+        Map<String, String> out = new HashMap<>();
+        for (String pair : value.split(";")) {
+            String[] parts = pair.split("=", 2);
+            if (parts.length == 2 && !parts[0].isBlank()) {
+                out.put(parts[0].trim(), parts[1].trim());
+            }
+        }
+        return out;
+    }
+}
