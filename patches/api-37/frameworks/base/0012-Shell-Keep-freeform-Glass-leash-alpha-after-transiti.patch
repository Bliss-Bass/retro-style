     /**
      * Applies RetroStyle {@code window_blur_radius} / {@code window_alpha} to the freeform task
-     * leash.
-     *
-     * <p>Translucency ({@code window_alpha}) is applied to every visible freeform task when set —
-     * gating it on {@code hasGlobalFocus} was resetting leash alpha to 1 on focus transitions and
-     * left Glass windows looking fully opaque. Background blur stays focused-only (GPU cost).
-     * Blur alone also applies a mild default alpha when {@code window_alpha} is unset, because
-     * opaque app buffers otherwise cover the blurred backdrop.
+     * leash (immediate + optional transition finishT).
      */
-    private void applyRetroUiWindowEffects(SurfaceControl taskSurface, boolean hasGlobalFocus) {
+    private void applyRetroUiWindowEffects(SurfaceControl taskSurface, boolean hasGlobalFocus,
+            @Nullable SurfaceControl.Transaction finishT) {
         if (taskSurface == null || !taskSurface.isValid()) {
             return;
         }
-        final SurfaceControl.Transaction t = mSurfaceControlTransactionSupplier.get();
-        final int blurPx = hasGlobalFocus ? RetroUiWindowStyle.blurRadiusPx(mContext) : 0;
-        t.setBackgroundBlurRadius(taskSurface, blurPx);
-
-        float alpha = RetroUiWindowStyle.windowAlpha(mContext);
-        // Opaque app buffers cover background blur; need leash translucency to see it.
-        if (alpha < 0f && blurPx > 0) {
-            alpha = 230f / 255f;
-        }
-        if (alpha >= 0f) {
-            t.setAlpha(taskSurface, Math.min(1f, Math.max(0f, alpha)));
+        final String pkg = RetroUiWindowStyle.packageName(mTaskInfo);
+        RetroUiWindowStyle.applyToTaskLeashNow(
+                mContext,
+                taskSurface,
+                pkg,
+                hasGlobalFocus,
+                mSurfaceControlTransactionSupplier.get());
+        if (finishT != null) {
+            RetroUiWindowStyle.applyToTaskLeash(
+                    finishT, mContext, taskSurface, pkg, hasGlobalFocus);
+        }
+        if (RetroUiWindowStyle.shouldSkipBlackTaskFill(mContext)
+                && !RetroUiWindowStyle.isAlphaDenied(pkg)) {
+            final SurfaceControl.Transaction clear = mSurfaceControlTransactionSupplier.get();
+            clear.unsetColor(taskSurface);
+            clear.apply();
+            if (finishT != null) {
+                finishT.unsetColor(taskSurface);
+            }
         }
-        t.apply();
