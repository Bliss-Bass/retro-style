 package com.android.wm.shell.windowdecor;
 
+import android.app.ActivityManager;
+import android.app.TaskInfo;
+import android.content.ComponentName;
 import android.content.Context;
 import android.provider.Settings;
 import android.util.DisplayMetrics;
+import android.view.SurfaceControl;
+
+import androidx.annotation.Nullable;
 
 import java.util.Collections;
 import java.util.HashMap;
 import java.util.Map;
+import java.util.Set;
 
 /**
  * Reads freeform window transparency/blur defaults from RetroStyle's {@code retro_ui_applied}
- * secure setting (pack defaults + UI Style overrides). Cap concurrent blurs by only applying
- * when the decoration has global focus.
+ * secure setting (pack defaults + UI Style overrides) and applies them to task leashes.
  *
  * <p>Values are re-read each call: SystemUI may start before the first APPLY, and UI Style can
  * change window keys without always restarting the Shell process that owns decorations.
+ *
+ * <p>Transition finish paths often hard-reset leash alpha to {@code 1f}; callers should apply
+ * into {@code finishT} and/or re-apply after finish so glass survives
+ * {@code Transition.buildFinishTransaction}.
  */
-final class RetroUiWindowStyle {
+public final class RetroUiWindowStyle {
     private static final String SETTING = "retro_ui_applied";
     private static final int MAX_BLUR_RADIUS_DP = 40;
+    /** Mild translucency so focused blur is visible when only blur radius is set. */
+    private static final float DEFAULT_ALPHA_WITH_BLUR = 230f / 255f;
+
+    /**
+     * Packages that keep stock opaque freeform leashes (games/camera/media). Settings and most
+     * system apps stay eligible so Glass can be validated.
+     */
+    private static final Set<String> ALPHA_DENYLIST = Set.of(
+            "com.android.camera2",
+            "com.android.camera",
+            "org.lineageos.aperture",
+            "com.android.gallery3d",
+            "com.google.android.apps.photos",
+            "org.lineageos.eleven",
+            "com.android.music",
+            "org.lineageos.recorder",
+            "com.android.systemui",
+            "com.android.launcher3",
+            "cu.axel.smartdock");
 
     private RetroUiWindowStyle() {}
 
@@ -54,7 +83,7 @@ final class RetroUiWindowStyle {
     }
 
     /**
-     * Window alpha 0–1 for the focused freeform task leash, or -1 when unset (leave stock).
+     * Window alpha 0–1 for the freeform task leash, or -1 when unset (leave stock).
      */
     static float windowAlpha(Context context) {
         String raw = values(context).get("window_alpha");
@@ -76,6 +105,113 @@ final class RetroUiWindowStyle {
         }
     }
 
+    /** True when UI Style / Glass asked for freeform leash translucency or blur. */
+    static boolean isGlassEnabled(Context context) {
+        return windowAlpha(context) >= 0f || blurRadiusPx(context) > 0;
+    }
+
+    /**
+     * Skip the solid black freeform task fill when glass alpha/blur is on so translucency is
+     * not a black veil under the leash.
+     */
+    static boolean shouldSkipBlackTaskFill(Context context) {
+        return isGlassEnabled(context);
+    }
+
+    static boolean isAlphaDenied(@Nullable String packageName) {
+        return packageName != null && ALPHA_DENYLIST.contains(packageName);
+    }
+
+    @Nullable
+    static String packageName(@Nullable TaskInfo taskInfo) {
+        if (taskInfo == null) {
+            return null;
+        }
+        ComponentName top = taskInfo.topActivity;
+        if (top != null) {
+            return top.getPackageName();
+        }
+        ComponentName real = taskInfo.realActivity;
+        if (real != null) {
+            return real.getPackageName();
+        }
+        if (taskInfo instanceof ActivityManager.RunningTaskInfo running
+                && running.baseActivity != null) {
+            return running.baseActivity.getPackageName();
+        }
+        return null;
+    }
+
+    /**
+     * Alpha to write into transition finish transactions instead of hard {@code 1f}, or
+     * {@code 1f} when glass is off / package denied.
+     */
+    static float finishAlpha(Context context, @Nullable String packageName) {
+        if (isAlphaDenied(packageName)) {
+            return 1f;
+        }
+        float alpha = windowAlpha(context);
+        int blurPx = blurRadiusPx(context);
+        if (alpha < 0f && blurPx > 0) {
+            alpha = DEFAULT_ALPHA_WITH_BLUR;
+        }
+        if (alpha < 0f) {
+            return 1f;
+        }
+        return Math.min(1f, Math.max(0f, alpha));
+    }
+
+    /**
+     * Applies RetroStyle window blur/alpha to a freeform task leash.
+     *
+     * <p>Blur is focus-gated (GPU cost). Alpha applies whenever set (and package is not
+     * denylisted) so focus transitions do not snap windows opaque. When blur is on and alpha
+     * is unset, a mild default alpha is used so opaque app buffers do not cover the blur.
+     *
+     * @param t transaction to mutate (caller applies, or pass a finishT so glass survives
+     *     transition end)
+     * @return true if any property was written
+     */
+    static boolean applyToTaskLeash(
+            @Nullable SurfaceControl.Transaction t,
+            Context context,
+            @Nullable SurfaceControl taskSurface,
+            @Nullable String packageName,
+            boolean hasGlobalFocus) {
+        if (t == null || taskSurface == null || !taskSurface.isValid()) {
+            return false;
+        }
+        boolean wrote = false;
+        final int blurPx = hasGlobalFocus ? blurRadiusPx(context) : 0;
+        t.setBackgroundBlurRadius(taskSurface, blurPx);
+        wrote = true;
+
+        if (isAlphaDenied(packageName)) {
+            return wrote;
+        }
+        float alpha = windowAlpha(context);
+        if (alpha < 0f && blurPx > 0) {
+            alpha = DEFAULT_ALPHA_WITH_BLUR;
+        }
+        if (alpha >= 0f) {
+            t.setAlpha(taskSurface, Math.min(1f, Math.max(0f, alpha)));
+            wrote = true;
+        }
+        return wrote;
+    }
+
+    /** Convenience: apply into {@code t} and immediately {@link SurfaceControl.Transaction#apply}. */
+    static void applyToTaskLeashNow(
+            Context context,
+            @Nullable SurfaceControl taskSurface,
+            @Nullable String packageName,
+            boolean hasGlobalFocus,
+            SurfaceControl.Transaction t) {
+        if (applyToTaskLeash(t, context, taskSurface, packageName, hasGlobalFocus)) {
+            t.apply();
+        }
+    }
+
     static Map<String, String> parse(String value) {
         if (value == null || value.isEmpty()) {
             return Collections.emptyMap();
