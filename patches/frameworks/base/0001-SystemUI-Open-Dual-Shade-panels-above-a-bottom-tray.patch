+package com.android.systemui.shade.shared.model
+
+import android.os.SystemProperties
+
+/**
+ * Where the floating Dual Shade panels open on wide screens.
+ *
+ * `persist.retro.panel_anchor=bottom_end` opens them above a bottom tray (tablet system bar)
+ * instead of under the top status bar. Read once per process; changing it restarts SystemUI.
+ */
+object ShadePanelAnchor {
+    const val PROPERTY = "persist.retro.panel_anchor"
+
+    val isBottom: Boolean by lazy { SystemProperties.get(PROPERTY) == "bottom_end" }
+}
