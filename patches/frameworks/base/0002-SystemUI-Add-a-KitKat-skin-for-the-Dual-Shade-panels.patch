+package com.android.systemui.shade.shared.model
+
+import android.os.SystemProperties
+
+/**
+ * The UI style SystemUI's shade panels are drawn in.
+ *
+ * `persist.retro.ui_style=kitkat` swaps the Quick Settings grid for KitKat tablet rows and uses Holo
+ * panel colors; `persist.retro.ui_style_variant` picks `holo_unified` (navy) or `kitkat_stock`
+ * (black). Read once per process; changing either restarts SystemUI.
+ */
+object RetroUiStyle {
+    const val PROPERTY = "persist.retro.ui_style"
+    const val VARIANT_PROPERTY = "persist.retro.ui_style_variant"
+
+    val isKitKat: Boolean by lazy { SystemProperties.get(PROPERTY) == "kitkat" }
+
+    /** Panel background (ARGB) for the KitKat style. */
+    val kitKatPanelColor: Int by lazy {
+        if (SystemProperties.get(VARIANT_PROPERTY) == "holo_unified") 0xCC1A1F2E.toInt()
+        else 0xF0000000.toInt()
+    }
+
+    /** Holo blue, the KitKat accent. */
+    const val HOLO_BLUE: Int = 0xFF33B5E5.toInt()
+}
