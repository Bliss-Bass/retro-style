+private val HoloBlue = Color(RetroUiStyle.HOLO_BLUE)
+private val HoloDivider = Color(0x33FFFFFF)
+private val SecondaryText = Color(0xFFBEBEBE)
+
+/** KitKat tablet clock header: large thin Holo-blue time with the date under it. */
+@Composable
+fun KitKatQuickSettingsHeader(modifier: Modifier = Modifier) {
+    Column(modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 12.dp)) {
+        AndroidView(
+            factory = { context ->
+                TextClock(context).apply {
+                    format12Hour = "h:mm a"
+                    format24Hour = "H:mm"
+                    textSize = 44f
+                    setTextColor(RetroUiStyle.HOLO_BLUE)
+                    typeface = Typeface.create("sans-serif-thin", Typeface.NORMAL)
+                }
+            }
+        )
+        AndroidView(
+            factory = { context ->
+                TextClock(context).apply {
+                    format12Hour = "EEEE, MMMM d"
+                    format24Hour = "EEEE, MMMM d"
+                    isAllCaps = true
+                    textSize = 12f
+                    setTextColor(SecondaryText.toArgb())
+                }
+            }
+        )
+    }
+    Spacer(Modifier.fillMaxWidth().height(1.dp).background(HoloDivider))
+}
+
+/** KitKat tablet quick settings: one full-width row per tile with a Holo ON/OFF switch. */
+@Composable
+fun KitKatTileList(
+    viewModel: TileGridViewModel,
+    listening: () -> Boolean,
+    modifier: Modifier = Modifier,
+) {
+    val tiles = viewModel.tileViewModels
+    TileListener(tiles, listening)
+    Column(modifier.fillMaxWidth()) {
+        tiles.forEach { tile ->
+            key(tile.spec) {
+                KitKatTileRow(tile)
+                Spacer(Modifier.fillMaxWidth().height(1.dp).background(HoloDivider))
+            }
+        }
+    }
+}
+
+@Composable
+private fun KitKatTileRow(tile: TileViewModel) {
+    val resources = LocalContext.current.resources
+    val uiState by
+        produceState(tile.currentState.toUiState(resources), tile, resources) {
+            tile.state.collect { value = it.toUiState(resources) }
+        }
+    val icon by
+        produceState(tile.currentState.toIconProvider(), tile) {
+            tile.state.collect { value = it.toIconProvider() }
+        }
+    val enabled = uiState.state != STATE_UNAVAILABLE
+    val active = uiState.state == STATE_ACTIVE
+
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(16.dp),
+        modifier =
+            Modifier.fillMaxWidth()
+                .heightIn(min = 52.dp)
+                .clickable(enabled = enabled) { tile.mainClick(null) }
+                .padding(horizontal = 16.dp, vertical = 6.dp),
+    ) {
+        SmallTileContent(
+            iconProvider = { kitKatTileIcon(icon) },
+            color = if (enabled) Color.White else SecondaryText,
+            size = { 24.dp },
+        )
+        Column(Modifier.weight(1f)) {
+            Text(
+                text = uiState.label,
+                color = if (enabled) Color.White else SecondaryText,
+                fontSize = 16.sp,
+                fontFamily = FontFamily.SansSerif,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+            if (uiState.secondaryLabel.isNotEmpty()) {
+                Text(
+                    text = uiState.secondaryLabel,
+                    color = SecondaryText,
+                    fontSize = 12.sp,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+            }
+        }
+        if (uiState.isToggleable || uiState.handlesSecondaryClick) {
+            HoloSwitch(
+                checked = active,
+                enabled = enabled,
+                onToggle = {
+                    if (uiState.handlesSecondaryClick) tile.toggleClick() else tile.mainClick(null)
+                },
+            )
+        }
+    }
+}
+
+/** The Holo ON/OFF switch: a dark track with a labelled thumb that turns blue when on. */
+@Composable
+private fun HoloSwitch(checked: Boolean, enabled: Boolean, onToggle: () -> Unit) {
+    val trackShape = RoundedCornerShape(2.dp)
+    Box(
+        contentAlignment = if (checked) Alignment.CenterEnd else Alignment.CenterStart,
+        modifier =
+            Modifier.width(80.dp)
+                .height(28.dp)
+                .clip(trackShape)
+                .background(Color(0x33FFFFFF))
+                .clickable(enabled = enabled, onClick = onToggle),
+    ) {
+        Box(
+            contentAlignment = Alignment.Center,
+            modifier =
+                Modifier.width(40.dp)
+                    .fillMaxHeight()
+                    .clip(trackShape)
+                    .background(if (checked) HoloBlue else Color(0xFF5A5A5A)),
+        ) {
+            Text(text = if (checked) "ON" else "OFF", color = Color.White, fontSize = 11.sp)
+        }
+    }
+}
+
+private fun Context.kitKatTileIcon(icon: IconProvider): Icon =
+    icon.icon?.let {
+        if (it is QSTileImpl.ResourceIcon) {
+            Icon.Resource(it.resId, null)
+        } else {
+            Icon.Loaded(it.getDrawable(this), null)
+        }
+    } ?: Icon.Resource(R.drawable.ic_error_outline, null)
