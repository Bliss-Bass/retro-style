diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ui/LauncherStatusIconsForwarder.kt b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ui/LauncherStatusIconsForwarder.kt
