+        notifyIconListChanged();
+    }
+
+    /** Runs {@code listener} after any slot icon is added, changed or removed. */
+    public void addIconListListener(Runnable listener) {
+        mIconListListeners.add(listener);
+    }
+
+    /** Stops calling a listener added with {@link #addIconListListener}. */
+    public void removeIconListListener(Runnable listener) {
+        mIconListListeners.remove(listener);
+    }
+
+    private void notifyIconListChanged() {
+        for (Runnable listener : mIconListListeners) {
+            listener.run();
+        }
+    }
+
+    /**
+     * The visible icons of slots that aren't on the icon hide list, in status bar order. Wi-Fi,
+     * mobile and other bindable icons are drawn by their own view models and aren't included.
+     */
+    public List<Pair<String, StatusBarIcon>> getVisibleSlotIcons() {
+        List<Pair<String, StatusBarIcon>> icons = new ArrayList<>();
+        for (Slot slot : mStatusBarIconList.getSlots()) {
+            if (mIconHideList.contains(slot.getName())) {
+                continue;
+            }
+            for (StatusBarIconHolder holder : slot.getHolderListInViewOrder()) {
+                StatusBarIcon icon = holder.getIcon();
+                if (holder.getType() == StatusBarIconHolder.TYPE_ICON && holder.isVisible()
+                        && icon != null && icon.visible) {
+                    icons.add(new Pair<>(slot.getName(), icon));
+                }
+            }
+        }
+        return icons;
     }
 
     void addBindableIcon(BindableIcon icon) {
@@ -419,6 +459,7 @@ public class StatusBarIconControllerImpl implements Tunable,
         int viewIndex = mStatusBarIconList.getViewIndex(slot, tag);
         mStatusBarIconList.removeIcon(slot, tag);
         mIconGroups.forEach(l -> l.onRemoveIcon(viewIndex));
+        notifyIconListChanged();
     }
 
     private void removeAllIconsForExternalSlot(String slotName) {
@@ -445,11 +486,13 @@ public class StatusBarIconControllerImpl implements Tunable,
             slot.removeForTag(holder.getTag());
             mIconGroups.forEach(l -> l.onRemoveIcon(viewIndex));
