@@ -0,0 +1,88 @@
+/*
+ * Copyright (C) 2026 Navotpala Tech (Bliss Co-Labs Inc.)
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Navotpala-Commercial
+ * Part of retro-style (vendor/retro-style). Licensed under the GNU Affero General Public
+ * License v3.0, or under a commercial license from Navotpala Tech (info@navotpala.tech).
+ * See LICENSE and LICENSE_COMMERCIAL in vendor/retro-style.
+ */
+
+package com.android.systemui.statusbar.phone.ui
+
+import android.os.Bundle
+import android.os.Handler
+import android.os.RemoteException
+import android.os.SystemProperties
+import android.util.Log
+import com.android.systemui.CoreStartable
+import com.android.systemui.LauncherProxyService
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.shared.recents.StatusBarIconsBundle
+import javax.inject.Inject
+
+/**
+ * Sends the status bar's slot icons (Bluetooth, alarm, Do Not Disturb, location, ...) to the
+ * launcher, so the tablet system bar tray shows the same icons, with the same hide list, as the
+ * status bar. Only active with `persist.retro.ui_layout=system_bar`.
+ */
+@SysUISingleton
+class LauncherStatusIconsForwarder
+@Inject
+constructor(
+    private val iconController: StatusBarIconControllerImpl,
+    private val launcherProxyService: LauncherProxyService,
+    @Main private val mainHandler: Handler,
+) : CoreStartable {
+
+    private val send = Runnable { sendIcons() }
+
+    override fun start() {
+        if (SystemProperties.get("persist.retro.ui_layout") != "system_bar") return
+        iconController.addIconListListener { schedule() }
+        launcherProxyService.addCallback(
+            object : LauncherProxyService.LauncherProxyListener {
+                override fun onConnectionChanged(isConnected: Boolean) {
+                    if (isConnected) schedule()
+                }
+            }
+        )
+        schedule()
+    }
+
+    /** Icons often change in bursts (e.g. on boot); send one update per burst. */
+    private fun schedule() {
+        mainHandler.removeCallbacks(send)
+        mainHandler.postDelayed(send, SEND_DELAY_MS)
+    }
+
+    private fun sendIcons() {
+        val proxy = launcherProxyService.proxy ?: return
+        val icons = iconController.visibleSlotIcons
+        val bundle =
+            Bundle().apply {
+                putStringArray(
+                    StatusBarIconsBundle.KEY_SLOTS,
+                    icons.map { it.first }.toTypedArray(),
+                )
+                putParcelableArray(
+                    StatusBarIconsBundle.KEY_ICONS,
+                    icons.map { it.second.icon }.toTypedArray(),
+                )
+                putCharSequenceArray(
+                    StatusBarIconsBundle.KEY_DESCRIPTIONS,
+                    icons.map { it.second.contentDescription }.toTypedArray(),
+                )
+            }
+        try {
+            proxy.onStatusBarIconsChanged(bundle)
+        } catch (e: RemoteException) {
+            Log.w(TAG, "Failed to send status bar icons to the launcher", e)
+        }
+    }
+
+    private companion object {
+        const val TAG = "LauncherStatusIcons"
+        const val SEND_DELAY_MS = 100L
+    }
+}
