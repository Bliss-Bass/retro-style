From bae3907afaf8b6ed9c1ffb9b94111c05a74ccb41 Mon Sep 17 00:00:00 2001
From: Jon West <electrikjesus@gmail.com>
Date: Wed, 4 Nov 2026 10:49:12 -0500
Subject: [PATCH 4/8] SystemUI: Leave the boot lockscreen state when idle off
 Lockscreen

With the scene container, SystemUI can start idle on Gone (lockscreen
disabled, setup wizard running). No scene transition then moves the
keyguard transition framework's boot transition to LOCKSCREEN on to
UNDEFINED, so notifications treat the lockscreen as showing: reordering
is never allowed and heads-up notifications never time out (and on the
desktop status bar a pinned heads-up makes the shade window take every
touch).
---
 .../LockscreenSceneTransitionInteractor.kt    | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/scenetransition/LockscreenSceneTransitionInteractor.kt b/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/scenetransition/LockscreenSceneTransitionInteractor.kt
index bb1009f7aafc..cb99db7d7549 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/scenetransition/LockscreenSceneTransitionInteractor.kt
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/scenetransition/LockscreenSceneTransitionInteractor.kt
@@ -39,6 +39,7 @@ import java.util.UUID
 import javax.inject.Inject
 import kotlinx.coroutines.CoroutineScope
 import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.combine
 
 /**
  * This class listens to scene framework scene transitions and manages keyguard transition framework
@@ -81,6 +82,33 @@ constructor(
     override fun start() {
         sceneInteractor.registerSceneStateProcessor(this)
         listenForSceneTransitionProgress()
+        listenForKtfLeftOnLockscreen()
+    }
+
+    /**
+     * SystemUI can start idle on a scene other than Lockscreen (lockscreen disabled, setup wizard
+     * running), so no scene transition ever moves KTF's boot transition to LOCKSCREEN on to
+     * UNDEFINED. Left there, notifications treat the lockscreen as showing: reordering is never
+     * allowed and heads-up notifications never time out.
+     */
+    private fun listenForKtfLeftOnLockscreen() {
+        applicationScope.launch {
+            combine(
+                    sceneInteractor.transitionState,
+                    transitionInteractor.startedKeyguardTransitionStep,
+                    ::Pair,
+                )
+                .collect { (sceneState, startedStep) ->
+                    if (
+                        currentTransitionId == null &&
+                            sceneState is ObservableTransitionState.Idle &&
+                            sceneState.currentScene != Scenes.Lockscreen &&
+                            startedStep.to == KeyguardState.LOCKSCREEN
+                    ) {
+                        transitionKtfTo(UNDEFINED)
+                    }
+                }
+        }
     }
 
     override fun onSceneAboutToChange(toScene: SceneKey, sceneState: Any?) {
