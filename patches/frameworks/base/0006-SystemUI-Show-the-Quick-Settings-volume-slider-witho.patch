     private val isEnabled =
-        QsDetailedView.isEnabled &&
+        SceneContainerFlag.isEnabled &&
             context.resources.getBoolean(R.bool.config_enableDesktopAudioTileDetailsView)
 
     fun isEnabled(): Boolean {
