From ce334b37e474c622f86bcbf9e1e12046fcdb0096 Mon Sep 17 00:00:00 2001
From: Jon West <electrikjesus@gmail.com>
Date: Wed, 4 Nov 2026 10:53:37 -0500
Subject: [PATCH 6/8] SystemUI: Show the Quick Settings volume slider without
 tile details

config_enableDesktopAudioTileDetailsView put a volume slider in the
Dual Shade Quick Settings panel only when the tile details view flag is
on as well. The slider doesn't need it; only its audio settings button
does, so show the slider with the scene container and hide the button
when tile details are off.
---
 .../composable/QuickSettingsShadeOverlay.kt   | 36 ++++++++++---------
 ...ickSettingsShadeOverlayContentViewModel.kt |  5 +--
 ...esktopAudioTileDetailsFeatureInteractor.kt |  6 ++--
 3 files changed, 27 insertions(+), 20 deletions(-)

diff --git a/packages/SystemUI/compose/features/src/com/android/systemui/qs/ui/composable/QuickSettingsShadeOverlay.kt b/packages/SystemUI/compose/features/src/com/android/systemui/qs/ui/composable/QuickSettingsShadeOverlay.kt
index 9e59bc4a1d9c..bcfb46970bb2 100644
--- a/packages/SystemUI/compose/features/src/com/android/systemui/qs/ui/composable/QuickSettingsShadeOverlay.kt
+++ b/packages/SystemUI/compose/features/src/com/android/systemui/qs/ui/composable/QuickSettingsShadeOverlay.kt
@@ -439,23 +439,27 @@ private fun ContentScope.QuickSettingsLayout(
                             hapticsViewModelFactory =
                                 volumeSliderViewModel.getSliderHapticsViewModelFactory(),
                         )
-                        IconButton(
-                            colors =
-                                IconButtonDefaults.iconButtonColors(
-                                    containerColor = MaterialTheme.colorScheme.primary,
-                                    contentColor = MaterialTheme.colorScheme.onPrimary,
-                                ),
-                            onClick = {
-                                qsContainerViewModel.detailsViewModel.onVolumeSettingsButtonClicked(
-                                    audioDetailsViewModelFactory.create()
+                        // Audio settings open as tile details, which need the detailed view.
+                        if (QsDetailedView.isEnabled) {
+                            IconButton(
+                                colors =
+                                    IconButtonDefaults.iconButtonColors(
+                                        containerColor = MaterialTheme.colorScheme.primary,
+                                        contentColor = MaterialTheme.colorScheme.onPrimary,
+                                    ),
+                                onClick = {
+                                    qsContainerViewModel.detailsViewModel
+                                        .onVolumeSettingsButtonClicked(
+                                            audioDetailsViewModelFactory.create()
+                                        )
+                                },
+                            ) {
+                                Icon(
+                                    painterResource(R.drawable.horizontal_ellipsis),
+                                    // TODO(b/378513663): Update the placeholder content description
+                                    contentDescription = "Volume settings",
                                 )
-                            },
-                        ) {
-                            Icon(
-                                painterResource(R.drawable.horizontal_ellipsis),
-                                // TODO(b/378513663): Update the placeholder content description
-                                contentDescription = "Volume settings",
-                            )
+                            }
                         }
                     }
                 }
diff --git a/packages/SystemUI/src/com/android/systemui/qs/ui/viewmodel/QuickSettingsShadeOverlayContentViewModel.kt b/packages/SystemUI/src/com/android/systemui/qs/ui/viewmodel/QuickSettingsShadeOverlayContentViewModel.kt
