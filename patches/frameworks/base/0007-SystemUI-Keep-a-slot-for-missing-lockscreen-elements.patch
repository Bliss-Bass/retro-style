From 96fb89ff40f711c1e874953eadc780d9534ab1b5 Mon Sep 17 00:00:00 2001
From: Jon West <electrikjesus@gmail.com>
Date: Wed, 4 Nov 2026 14:40:58 -0500
Subject: [PATCH 7/8] SystemUI: Keep a slot for missing lockscreen elements

With the scene container, LockscreenSceneLayout checks that it measures
exactly six children, but AOSP has no provider for
AmbientIndicationArea, so the factory emitted nothing for it and
SystemUI crashed whenever the lockscreen showed (after every restart
with a lockscreen set), until the device rebooted. Emit an empty
Spacer for elements nobody provides.
---
 .../ui/composable/elements/LockscreenElementFactoryImpl.kt    | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/packages/SystemUI/compose/features/src/com/android/systemui/keyguard/ui/composable/elements/LockscreenElementFactoryImpl.kt b/packages/SystemUI/compose/features/src/com/android/systemui/keyguard/ui/composable/elements/LockscreenElementFactoryImpl.kt
index dca54a86d5cd..5ebe4e36ae51 100644
--- a/packages/SystemUI/compose/features/src/com/android/systemui/keyguard/ui/composable/elements/LockscreenElementFactoryImpl.kt
+++ b/packages/SystemUI/compose/features/src/com/android/systemui/keyguard/ui/composable/elements/LockscreenElementFactoryImpl.kt
@@ -14,6 +14,7 @@
 
 package com.android.systemui.keyguard.ui.composable.elements
 
+import androidx.compose.foundation.layout.Spacer
 import androidx.compose.runtime.Composable
 import androidx.compose.runtime.CompositionLocalProvider
 import androidx.compose.runtime.Immutable
@@ -54,6 +55,9 @@ constructor(
         val element = elements[key]
         if (element == null) {
             logger.e({ "No lockscreen element available at key: $str1" }) { str1 = "$key" }
+            // Layouts such as LockscreenSceneLayout measure a fixed set of children, so keep an
+            // empty slot (AOSP has no AmbientIndicationArea provider, for one).
+            Spacer(modifier)
             return
         }
 
