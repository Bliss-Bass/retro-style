@@ -0,0 +1,44 @@
+/*
+ * Copyright (C) 2026 Navotpala Tech (Bliss Co-Labs Inc.)
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Navotpala-Commercial
+ * Part of retro-style (vendor/retro-style). Licensed under the GNU Affero General Public
+ * License v3.0, or under a commercial license from Navotpala Tech (info@navotpala.tech).
+ * See LICENSE and LICENSE_COMMERCIAL in vendor/retro-style.
+ */
+
+package com.android.systemui.shade.shared.model
+
+import android.app.AppGlobals
+import android.provider.Settings
+
+/**
+ * The retro style the RetroStyle app (vendor/retro-style) last applied.
+ *
+ * The app resolves the user's choices and their defaults and writes them to the secure setting
+ * `retro_ui_applied` as `key=value` pairs separated by `;`, for example
+ * `style=kitkat;variant=kitkat_stock;layout=system_bar;anchor=bottom_end`. A secure setting needs
+ * no SELinux policy, unlike a custom system property. Read once per process: the app restarts
+ * SystemUI when a value SystemUI uses changes.
+ */
+object RetroUiApplied {
+    const val SETTING = "retro_ui_applied"
+
+    private val values: Map<String, String> by lazy {
+        val resolver = AppGlobals.getInitialApplication()?.contentResolver
+        parse(resolver?.let { Settings.Secure.getString(it, SETTING) })
+    }
+
+    operator fun get(key: String): String? = values[key]
+
+    fun parse(value: String?): Map<String, String> =
+        value
+            .orEmpty()
+            .split(';')
+            .mapNotNull { pair ->
+                val parts = pair.split('=', limit = 2)
+                if (parts.size == 2 && parts[0].isNotBlank()) parts[0].trim() to parts[1].trim()
+                else null
+            }
+            .toMap()
+}
