+package com.android.systemui.shade.shared.model
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.filters.SmallTest
+import com.android.systemui.SysuiTestCase
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@SmallTest
+@RunWith(AndroidJUnit4::class)
+class RetroUiAppliedTest : SysuiTestCase() {
+
+    @Test
+    fun parse_readsPairs() {
+        assertThat(
+                RetroUiApplied.parse("style=kitkat;anchor=bottom_end;bar_buttons=vol_down,power")
+            )
+            .containsExactly(
+                "style",
+                "kitkat",
+                "anchor",
+                "bottom_end",
+                "bar_buttons",
+                "vol_down,power",
+            )
+    }
+
+    @Test
+    fun parse_skipsMalformedPairs() {
+        assertThat(RetroUiApplied.parse("style=m3;;broken;=x;variant="))
+            .containsExactly("style", "m3", "variant", "")
+    }
+
+    @Test
+    fun parse_unsetIsEmpty() {
+        assertThat(RetroUiApplied.parse(null)).isEmpty()
+    }
+}
