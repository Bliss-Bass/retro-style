diff --git a/quickstep/src/com/android/launcher3/taskbar/TaskbarSystemTrayView.kt b/quickstep/src/com/android/launcher3/taskbar/TaskbarSystemTrayView.kt
new file mode 100644
index 00000000000..f7d282831a4
--- /dev/null
+++ b/quickstep/src/com/android/launcher3/taskbar/TaskbarSystemTrayView.kt
@@ -0,0 +1,296 @@
+/*
+ * Copyright (C) 2026 Navotpala Tech (Bliss Co-Labs Inc.)
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Navotpala-Commercial
+ * Part of retro-style (vendor/retro-style). Licensed under the GNU Affero General Public
+ * License v3.0, or under a commercial license from Navotpala Tech (info@navotpala.tech).
+ * See LICENSE and LICENSE_COMMERCIAL in vendor/retro-style.
+ */
+
+package com.android.launcher3.taskbar
+
+import android.app.Notification
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.res.Configuration
+import android.graphics.Typeface
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.media.AudioManager
+import android.net.ConnectivityManager
+import android.net.Network
+import android.net.NetworkCapabilities
+import android.net.wifi.WifiManager
+import android.os.BatteryManager
+import android.service.notification.StatusBarNotification
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextClock
+import android.widget.TextView
+import com.android.launcher3.R
+import com.android.launcher3.notification.NotificationListener
+import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_NOTIFICATIONS
+import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_QUICK_SETTINGS
+import java.util.function.Consumer
+
+/**
+ * The tablet system bar tray: notification icons, network and battery, volume and the clock.
+ *
+ * Tapping the notifications opens the notification panel and tapping the status icons or the clock
+ * opens Quick Settings, both on this taskbar's display. Material style draws Googlebook-like
+ * capsules in the dynamic colors; KitKat style draws flat white icons and a thin Holo-blue clock.
+ */
+class TaskbarSystemTrayView(
+    context: Context,
+    private val navButtonController: TaskbarNavButtonController,
+) : LinearLayout(context) {
+
+    private val kitKat = RetroSystemBar.isKitKat
+    private val iconSize = dp(if (kitKat) 20f else 18f)
+    private val contentColor: Int
+    private val notificationIcons = LinearLayout(context)
+    private val notificationCount = TextView(context)
+    private val networkIcon = ImageView(context)
+    private val batteryIcon = ImageView(context)
+    private val batteryText = TextView(context)
+    private val clock = TextClock(context)
+
+    private val notificationCallback =
+        Consumer<Array<StatusBarNotification>> { active ->
+            val shown =
+                active.filter { (it.notification.flags and Notification.FLAG_GROUP_SUMMARY) == 0 }
+            val icons =
+                shown
+                    .distinctBy { it.packageName }
+                    .take(MAX_NOTIFICATION_ICONS)
+                    .mapNotNull { it.notification.smallIcon?.loadDrawable(context) }
+            post { showNotifications(icons, shown.size) }
+        }
+
+    private val batteryReceiver =
+        object : BroadcastReceiver() {
+            override fun onReceive(context: Context, intent: Intent) {
+                val level = intent.getIntExtra(BatteryManager.EXTRA_LEVEL, -1)
+                val scale = intent.getIntExtra(BatteryManager.EXTRA_SCALE, 100)
+                val present = intent.getBooleanExtra(BatteryManager.EXTRA_PRESENT, true)
+                if (!present || level < 0) {
+                    batteryIcon.visibility = GONE
+                    batteryText.visibility = GONE
+                    return
+                }
+                val percent = level * 100 / scale.coerceAtLeast(1)
+                batteryIcon.visibility = VISIBLE
+                batteryIcon.setImageLevel(percent)
+                batteryText.visibility = VISIBLE
+                batteryText.text = context.getString(R.string.retro_system_bar_battery, percent)
+            }
+        }
+
+    private val networkCallback =
+        object : ConnectivityManager.NetworkCallback() {
+            override fun onCapabilitiesChanged(network: Network, caps: NetworkCapabilities) {
+                post { showNetwork(caps) }
+            }
+
+            override fun onLost(network: Network) {
+                post { networkIcon.visibility = GONE }
+            }
+        }
+
+    init {
+        orientation = HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+        val night =
+            (resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) ==
+                Configuration.UI_MODE_NIGHT_YES
+        contentColor =
+            when {
+                kitKat -> 0xFFFFFFFF.toInt()
+                night -> context.getColor(android.R.color.system_neutral1_50)
+                else -> context.getColor(android.R.color.system_neutral1_900)
+            }
+
+        notificationIcons.orientation = HORIZONTAL
+        notificationIcons.gravity = Gravity.CENTER_VERTICAL
+        notificationCount.setTextColor(contentColor)
+        notificationCount.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+        notificationCount.gravity = Gravity.CENTER
+        val notifications = group(notificationIcons, notificationCount)
+        notifications.contentDescription = context.getString(R.string.taskbar_button_notifications)
+        notifications.setOnClickListener {
+            navButtonController.onButtonClick(BUTTON_NOTIFICATIONS, it)
+        }
+        notifications.visibility = GONE
+
+        networkIcon.visibility = GONE
+        batteryIcon.setImageResource(R.drawable.ic_retro_tray_battery)
+        batteryText.setTextColor(if (kitKat) HOLO_BLUE else contentColor)
+        batteryText.setTextSize(TypedValue.COMPLEX_UNIT_SP, if (kitKat) 18f else 12f)
+        if (kitKat) batteryText.typeface = Typeface.create("sans-serif-light", Typeface.NORMAL)
+        listOf(networkIcon, batteryIcon).forEach {
+            styleIcon(it, if (kitKat) HOLO_BLUE else contentColor)
+        }
+        val status = group(networkIcon, batteryIcon, batteryText)
+        status.contentDescription = context.getString(R.string.taskbar_button_quick_settings)
+        status.setOnClickListener { navButtonController.onButtonClick(BUTTON_QUICK_SETTINGS, it) }
+
+        if (kitKat) {
+            clock.format12Hour = if (RetroSystemBar.clockSeconds) "h:mm:ss a" else "h:mm a"
+            clock.format24Hour = if (RetroSystemBar.clockSeconds) "H:mm:ss" else "H:mm"
+            clock.setTextColor(HOLO_BLUE)
+            clock.setTextSize(TypedValue.COMPLEX_UNIT_SP, 26f)
+            clock.typeface = Typeface.create("sans-serif-thin", Typeface.NORMAL)
+        } else {
+            clock.format12Hour = if (RetroSystemBar.clockSeconds) "h:mm:ss a" else "h:mm a"
+            clock.format24Hour = if (RetroSystemBar.clockSeconds) "H:mm:ss" else "H:mm"
+            clock.setTextColor(contentColor)
+            clock.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        }
+        clock.setPadding(dp(8f), 0, dp(8f), 0)
+        clock.setOnClickListener { navButtonController.onButtonClick(BUTTON_QUICK_SETTINGS, it) }
+
+        addView(notifications)
+        addView(status)
+        if (!kitKat) {
+            // KitKat has volume buttons with the nav buttons; Material keeps it in the tray.
+            val volume = ImageView(context)
+            volume.setImageResource(R.drawable.ic_retro_tray_volume)
+            volume.contentDescription = context.getString(R.string.retro_system_bar_volume)
+            styleIcon(volume)
+            volume.setOnClickListener {
+                context
+                    .getSystemService(AudioManager::class.java)
+                    ?.adjustSuggestedStreamVolume(
+                        AudioManager.ADJUST_SAME,
+                        AudioManager.USE_DEFAULT_STREAM_TYPE,
+                        AudioManager.FLAG_SHOW_UI,
+                    )
+            }
+            addView(group(volume))
+        }
+        addView(clock)
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        context.registerReceiver(batteryReceiver, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+        try {
+            context
+                .getSystemService(ConnectivityManager::class.java)
+                ?.registerDefaultNetworkCallback(networkCallback)
+        } catch (e: SecurityException) {
+            networkIcon.visibility = GONE
+        }
+        NotificationListener.addTrayCallback(notificationCallback)
+    }
+
+    override fun onDetachedFromWindow() {
+        NotificationListener.removeTrayCallback(notificationCallback)
+        context.getSystemService(ConnectivityManager::class.java)?.let {
+            try {
+                it.unregisterNetworkCallback(networkCallback)
+            } catch (e: IllegalArgumentException) {
+                // Never registered.
+            }
+        }
+        try {
+            context.unregisterReceiver(batteryReceiver)
+        } catch (e: IllegalArgumentException) {
+            // Never registered.
+        }
+        super.onDetachedFromWindow()
+    }
+
+    private fun showNotifications(icons: List<Drawable>, count: Int) {
+        val notifications = notificationIcons.parent as View
+        notifications.visibility = if (count > 0) VISIBLE else GONE
+        notificationIcons.removeAllViews()
+        if (kitKat) {
+            // KitKat lists the icons themselves.
+            icons.forEach { icon ->
+                val view = ImageView(context)
+                view.setImageDrawable(icon)
+                styleIcon(view)
+                notificationIcons.addView(view)
+            }
+            notificationCount.visibility = GONE
+        } else {
+            // Material shows a count bubble, like the Googlebook tray.
+            notificationCount.text = count.toString()
+            notificationCount.visibility = VISIBLE
+            notificationCount.background =
+                GradientDrawable().apply {
+                    shape = GradientDrawable.OVAL
+                    setStroke(dp(1.5f), contentColor)
+                }
+            notificationCount.minWidth = dp(22f)
+            notificationCount.minHeight = dp(22f)
+        }
+    }
+
+    private fun showNetwork(caps: NetworkCapabilities) {
+        when {
+            caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI) -> {
+                networkIcon.setImageResource(R.drawable.ic_retro_tray_wifi)
+                val rssi = caps.signalStrength
+                val level =
+                    if (rssi == NetworkCapabilities.SIGNAL_STRENGTH_UNSPECIFIED) WIFI_LEVELS - 1
+                    else
+                        context
+                            .getSystemService(WifiManager::class.java)
+                            ?.calculateSignalLevel(rssi) ?: (WIFI_LEVELS - 1)
+                networkIcon.setImageLevel(level)
+                networkIcon.visibility = VISIBLE
+            }
+            caps.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET) -> {
+                networkIcon.setImageResource(R.drawable.ic_retro_tray_ethernet)
+                networkIcon.visibility = VISIBLE
+            }
+            else -> networkIcon.visibility = GONE
+        }
+    }
+
+    /** Wraps tray items in one tappable group; Material groups get a capsule background. */
+    private fun group(vararg views: View): LinearLayout {
+        val group = LinearLayout(context)
+        group.orientation = HORIZONTAL
+        group.gravity = Gravity.CENTER_VERTICAL
+        group.setPadding(dp(8f), dp(4f), dp(8f), dp(4f))
+        group.isClickable = true
+        group.isFocusable = true
+        if (!kitKat) {
+            group.background =
+                GradientDrawable().apply {
+                    cornerRadius = dp(16f).toFloat()
+                    setStroke(dp(1f), contentColor and 0x60FFFFFF)
+                }
+        }
+        val params = LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT)
+        params.marginStart = dp(4f)
+        views.forEach { group.addView(it) }
+        group.layoutParams = params
+        return group
+    }
+
+    private fun styleIcon(view: ImageView, color: Int = contentColor) {
+        view.setColorFilter(color)
+        val params = LayoutParams(iconSize, iconSize)
+        params.marginEnd = dp(4f)
+        view.layoutParams = params
+    }
+
+    private fun dp(value: Float): Int =
+        TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, value, resources.displayMetrics)
+            .toInt()
+
+    companion object {
+        private const val MAX_NOTIFICATION_ICONS = 4
+        private const val WIFI_LEVELS = 5
+        private const val HOLO_BLUE = 0xFF33B5E5.toInt()
+    }
+}
