+
+package com.android.launcher3.taskbar.navbutton
+
+import android.content.res.Resources
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.Space
+import com.android.launcher3.R
+import com.android.launcher3.taskbar.RetroSystemBar
+import com.android.launcher3.taskbar.TaskbarActivityContext
+
+/**
+ * Layoutter for the tablet system bar: back/home/recents and the extra buttons at the start, then
+ * the IME switcher and accessibility button. The end of the bar belongs to the tray.
+ */
+class SystemBarNavLayoutter(
+    resources: Resources,
+    navBarContainer: LinearLayout,
+    endContextualContainer: ViewGroup,
+    startContextualContainer: ViewGroup,
+    imeSwitcher: ImageView?,
+    a11yButton: ImageView?,
+    space: Space?,
+) :
+    AbstractNavButtonLayoutter(
+        resources,
+        navBarContainer,
+        endContextualContainer,
+        startContextualContainer,
+        imeSwitcher,
+        a11yButton,
+        space,
+    ) {
+
+    override fun layoutButtons(context: TaskbarActivityContext, isA11yButtonPersistent: Boolean) {
+        val extras =
+            (0 until navButtonContainer.childCount)
+                .map { navButtonContainer.getChildAt(it) }
+                .filter { RetroSystemBar.isExtraButton(it.id) }
+
+        addThreeButtons()
+        extras.forEach { navButtonContainer.addView(it) }
+
+        endContextualContainer.removeAllViews()
+        startContextualContainer.removeAllViews()
+        listOfNotNull(imeSwitcher, a11yButton).forEach { button ->
+            (button.parent as? ViewGroup)?.removeView(button)
+            navButtonContainer.addView(button)
+        }
+
+        val buttonWidth = resources.getDimensionPixelSize(R.dimen.retro_system_bar_button_width)
+        for (i in 0 until navButtonContainer.childCount) {
+            val button: View = navButtonContainer.getChildAt(i)
+            button.layoutParams =
+                LinearLayout.LayoutParams(buttonWidth, ViewGroup.LayoutParams.MATCH_PARENT)
+        }
+
+        navButtonContainer.orientation = LinearLayout.HORIZONTAL
+        navButtonContainer.layoutParams =
+            FrameLayout.LayoutParams(
+                    FrameLayout.LayoutParams.WRAP_CONTENT,
+                    ViewGroup.LayoutParams.MATCH_PARENT,
+                )
+                .apply {
+                    gravity = Gravity.START or Gravity.CENTER_VERTICAL
+                    marginStart =
+                        resources.getDimensionPixelSize(R.dimen.retro_system_bar_edge_margin)
+                }
+    }
+}
