diff --git a/quickstep/src/com/android/launcher3/taskbar/RetroSystemBar.kt b/quickstep/src/com/android/launcher3/taskbar/RetroSystemBar.kt
new file mode 100644
index 00000000000..627040ac656
--- /dev/null
+++ b/quickstep/src/com/android/launcher3/taskbar/RetroSystemBar.kt
@@ -0,0 +1,76 @@
+/*
+ * Copyright (C) 2026 Navotpala Tech (Bliss Co-Labs Inc.)
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Navotpala-Commercial
+ * Part of retro-style (vendor/retro-style). Licensed under the GNU Affero General Public
+ * License v3.0, or under a commercial license from Navotpala Tech (info@navotpala.tech).
+ * See LICENSE and LICENSE_COMMERCIAL in vendor/retro-style.
+ */
+
+package com.android.launcher3.taskbar
+
+import android.os.SystemProperties
+import com.android.launcher3.R
+import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_POWER
+import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_SCREENSHOT
+import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_VOLUME_DOWN
+import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_VOLUME_UP
+
+/**
+ * The tablet "system bar" taskbar layout: nav buttons at the start, optional extra buttons, and a
+ * tray (notifications, status, volume, clock) at the end.
+ *
+ * Driven by `persist.retro.ui_layout=system_bar`; `persist.retro.ui_style=kitkat` switches the tray
+ * to the KitKat look and hides the app icons. Read once per process; the RetroStyle app restarts the
+ * launcher when they change.
+ */
+object RetroSystemBar {
+    @JvmStatic
+    val isEnabled: Boolean by lazy {
+        SystemProperties.get("persist.retro.ui_layout") == "system_bar"
+    }
+
+    @JvmStatic
+    val isKitKat: Boolean by lazy { SystemProperties.get("persist.retro.ui_style") == "kitkat" }
+
+    /** App icons between the nav buttons and the tray (off by default for KitKat). */
+    @JvmStatic
+    val showApps: Boolean by lazy {
+        SystemProperties.getBoolean("persist.retro.ui_bar_apps", !isKitKat)
+    }
+
+    /** Seconds on the tray clock. */
+    @JvmStatic
+    val clockSeconds: Boolean by lazy {
+        SystemProperties.getBoolean("persist.retro.ui_bar_clock_seconds", false)
+    }
+
+    private val extraButtonsByName =
+        mapOf(
+            "vol_down" to
+                ExtraButton(
+                    BUTTON_VOLUME_DOWN,
+                    R.drawable.ic_retro_volume_down,
+                    R.id.retro_volume_down,
+                ),
+            "vol_up" to
+                ExtraButton(BUTTON_VOLUME_UP, R.drawable.ic_retro_volume_up, R.id.retro_volume_up),
+            "screenshot" to
+                ExtraButton(BUTTON_SCREENSHOT, R.drawable.ic_retro_screenshot, R.id.retro_screenshot),
+            "power" to ExtraButton(BUTTON_POWER, R.drawable.ic_retro_power, R.id.retro_power),
+        )
+
+    /** Extra nav buttons in `persist.retro.ui_bar_buttons` order (TabletKat-style button order). */
+    @JvmStatic
+    val extraButtons: List<ExtraButton> by lazy {
+        if (!isEnabled) return@lazy emptyList()
+        SystemProperties.get("persist.retro.ui_bar_buttons", "vol_down,vol_up,screenshot")
+            .split(',')
+            .mapNotNull { extraButtonsByName[it.trim()] }
+    }
+
+    @JvmStatic
+    fun isExtraButton(viewId: Int): Boolean = extraButtonsByName.values.any { it.id == viewId }
+
+    data class ExtraButton(val type: Int, val drawable: Int, val id: Int)
+}
