+    /** SystemUI's status bar slot icons (Bluetooth, alarm, Do Not Disturb, location, ...). */
+    private fun showStatusBarIcons(bundle: Bundle) {
+        val slots = bundle.getStringArray(StatusBarIconsBundle.KEY_SLOTS) ?: emptyArray()
+        val icons =
+            bundle.getParcelableArray(StatusBarIconsBundle.KEY_ICONS, Icon::class.java)
+                ?: emptyArray()
+        val descriptions =
+            bundle.getCharSequenceArray(StatusBarIconsBundle.KEY_DESCRIPTIONS) ?: emptyArray()
+        systemIcons.removeAllViews()
+        for (i in slots.indices) {
+            // The tray draws network and battery itself.
+            if (slots[i] in TRAY_DRAWN_SLOTS) continue
+            val drawable = icons.getOrNull(i)?.loadDrawable(context) ?: continue
+            val view = ImageView(context)
+            view.setImageDrawable(drawable)
+            view.contentDescription = descriptions.getOrNull(i)
+            styleIcon(view)
+            systemIcons.addView(view)
+        }
+    }
+
     private fun showNetwork(caps: NetworkCapabilities) {
         when {
             caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI) -> {
@@ -293,5 +323,17 @@ class TaskbarSystemTrayView(
         private const val MAX_NOTIFICATION_ICONS = 4
         private const val WIFI_LEVELS = 5
         private const val HOLO_BLUE = 0xFF33B5E5.toInt()
+        private val TRAY_DRAWN_SLOTS = setOf("wifi", "mobile", "ethernet", "battery")
+
+        // Main thread only.
+        private val trays = mutableSetOf<TaskbarSystemTrayView>()
+        private var lastStatusBarIcons: Bundle? = null
+
+        /** Shows SystemUI's status bar icons (from ILauncherProxy) in every tray. Main thread. */
+        @JvmStatic
+        fun dispatchStatusBarIcons(icons: Bundle) {
+            lastStatusBarIcons = icons
+            trays.forEach { it.showStatusBarIcons(icons) }
+        }
     }
 }
