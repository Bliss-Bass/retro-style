+        notificationBell.visibility = if (count > 0) GONE else VISIBLE
+        if (count == 0) {
+            notificationCount.visibility = GONE
+        } else if (kitKat) {
             // KitKat lists the icons themselves.
             icons.forEach { icon ->
                 val view = ImageView(context)
