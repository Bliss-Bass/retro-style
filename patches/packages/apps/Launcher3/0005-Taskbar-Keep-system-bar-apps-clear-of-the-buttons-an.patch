         }
+        if (RetroSystemBar.isEnabled() && !mActivityContext.isPhoneMode()) {
+            // The system bar has its buttons at the start and the tray at the end.
+            iconEnd = RetroSystemBar.iconEnd(this, spaceNeeded, layoutRtl);
+        }
 
         // Currently, we support only one device with display cutout and we only are concern about
         // it when the bottom rect is present and non empty
