diff --git a/quickstep/src/com/android/launcher3/taskbar/RetroSystemBar.kt b/quickstep/src/com/android/launcher3/taskbar/RetroSystemBar.kt
index 627040ac656..605cee362b8 100644
--- a/quickstep/src/com/android/launcher3/taskbar/RetroSystemBar.kt
+++ b/quickstep/src/com/android/launcher3/taskbar/RetroSystemBar.kt
@@ -9,12 +9,16 @@
 
 package com.android.launcher3.taskbar
 
+import android.graphics.Rect
 import android.os.SystemProperties
+import android.view.View
+import android.view.ViewGroup
 import com.android.launcher3.R
 import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_POWER
 import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_SCREENSHOT
 import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_VOLUME_DOWN
 import com.android.launcher3.taskbar.TaskbarNavButtonController.BUTTON_VOLUME_UP
+import kotlin.math.max
 
 /**
  * The tablet "system bar" taskbar layout: nav buttons at the start, optional extra buttons, and a
@@ -60,17 +64,77 @@ object RetroSystemBar {
             "power" to ExtraButton(BUTTON_POWER, R.drawable.ic_retro_power, R.id.retro_power),
         )
 
-    /** Extra nav buttons in `persist.retro.ui_bar_buttons` order (TabletKat-style button order). */
+    /** Extra nav buttons in `persist.retro.ui_bar_buttons` order; none unless chosen in Settings. */
     @JvmStatic
     val extraButtons: List<ExtraButton> by lazy {
         if (!isEnabled) return@lazy emptyList()
-        SystemProperties.get("persist.retro.ui_bar_buttons", "vol_down,vol_up,screenshot")
-            .split(',')
-            .mapNotNull { extraButtonsByName[it.trim()] }
+        SystemProperties.get("persist.retro.ui_bar_buttons", "").split(',').mapNotNull {
+            extraButtonsByName[it.trim()]
+        }
     }
 
     @JvmStatic
     fun isExtraButton(viewId: Int): Boolean = extraButtonsByName.values.any { it.id == viewId }
 
+    /** Where the app icons sit between the buttons and the tray: `start`, `center` or `end`. */
+    @JvmStatic
+    val appsGravity: String by lazy {
+        when (val gravity = SystemProperties.get("persist.retro.ui_bar_apps_gravity")) {
+            GRAVITY_START,
+            GRAVITY_END -> gravity
+            else -> GRAVITY_CENTER
+        }
+    }
+
+    /**
+     * The end (right edge) of [taskbarView]'s icon row, kept clear of the start buttons and the
+     * tray, which the nav buttons view lays out over the same bar.
+     */
+    @JvmStatic
+    fun iconEnd(taskbarView: View, spaceNeeded: Int, rtl: Boolean): Int {
+        val root = taskbarView.rootView as? ViewGroup ?: return taskbarView.width
+        val buttons = root.findViewById<View>(R.id.end_nav_buttons)
+        val tray = root.findViewById<View>(R.id.retro_system_tray)
+        relayoutOnChange(taskbarView, buttons)
+        relayoutOnChange(taskbarView, tray)
+
+        val origin = boundsIn(root, taskbarView) ?: return taskbarView.width
+        val gap = taskbarView.resources.getDimensionPixelSize(R.dimen.retro_system_bar_edge_margin)
+        val buttonsBounds = boundsIn(root, buttons)?.apply { offset(-origin.left, 0) }
+        val trayBounds = boundsIn(root, tray)?.apply { offset(-origin.left, 0) }
+        val leftGroup = if (rtl) trayBounds else buttonsBounds
+        val rightGroup = if (rtl) buttonsBounds else trayBounds
+        val minEnd = (leftGroup?.right ?: 0) + gap + spaceNeeded
+        val maxEnd = max(minEnd, (rightGroup?.left ?: taskbarView.width) - gap)
+        val startEnd = if (rtl) maxEnd else minEnd
+        val endEnd = if (rtl) minEnd else maxEnd
+        return when (appsGravity) {
+            GRAVITY_START -> startEnd
+            GRAVITY_END -> endEnd
+            else -> ((taskbarView.width + spaceNeeded) / 2).coerceIn(minEnd, maxEnd)
+        }
+    }
+
+    /** Layout bounds of [view] in [root], ignoring animation transforms. */
+    private fun boundsIn(root: ViewGroup, view: View?): Rect? {
+        if (view == null || view.width == 0 || !view.isAttachedToWindow) return null
+        val bounds = Rect(0, 0, view.width, view.height)
+        root.offsetDescendantRectToMyCoords(view, bounds)
+        return bounds
+    }
+
+    private fun relayoutOnChange(taskbarView: View, view: View?) {
+        if (view == null || view.getTag(R.id.retro_system_bar_apps_relayout) != null) return
+        view.setTag(R.id.retro_system_bar_apps_relayout, true)
+        view.addOnLayoutChangeListener { _, left, _, right, _, oldLeft, _, oldRight, _ ->
+            if (left != oldLeft || right != oldRight)
+                taskbarView.post { taskbarView.requestLayout() }
+        }
+    }
+
+    private const val GRAVITY_START = "start"
+    private const val GRAVITY_CENTER = "center"
+    private const val GRAVITY_END = "end"
+
     data class ExtraButton(val type: Int, val drawable: Int, val id: Int)
 }
