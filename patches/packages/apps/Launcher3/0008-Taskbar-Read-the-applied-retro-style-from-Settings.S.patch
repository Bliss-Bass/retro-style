+
+package com.android.launcher3.taskbar
+
+import android.app.AppGlobals
+import android.provider.Settings
+
+/**
+ * The retro style the RetroStyle app (vendor/retro-style) last applied.
+ *
+ * The app resolves the user's choices and their defaults and writes them to the secure setting
+ * `retro_ui_applied` as `key=value` pairs separated by `;`, for example
+ * `style=kitkat;layout=system_bar;bar_apps=0;bar_buttons=vol_down,power`. A secure setting needs no
+ * SELinux policy, unlike a custom system property. Read once per process: the app restarts the
+ * launcher when a value it uses changes. SystemUI has its own copy of this reader.
+ */
+object RetroUiApplied {
+    const val SETTING = "retro_ui_applied"
+
+    private val values: Map<String, String> by lazy {
+        val resolver = AppGlobals.getInitialApplication()?.contentResolver
+        parse(resolver?.let { Settings.Secure.getString(it, SETTING) })
+    }
+
+    operator fun get(key: String): String? = values[key]
+
+    fun parse(value: String?): Map<String, String> =
+        value
+            .orEmpty()
+            .split(';')
+            .mapNotNull { pair ->
+                val parts = pair.split('=', limit = 2)
+                if (parts.size == 2 && parts[0].isNotBlank()) parts[0].trim() to parts[1].trim()
+                else null
+            }
+            .toMap()
+}
