+ * See LICENSE and LICENSE_COMMERCIAL in vendor/retro-style.
+ */
+
+package com.android.launcher3.taskbar
+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Shader
+import com.android.launcher3.R
+
+/**
+ * The tablet system bar's background on the home screen, from `bar_background` in
+ * [RetroUiApplied]:
+ * - `solid`: the bar color (`taskbar_background`, which theme packs recolor), opaque.
+ * - `gradient`: a shadow that fades from clear at the top of the bar to dark at the bottom, as the
+ *   Android 4.x home screen drew behind its navigation buttons.
+ * - `translucent`: the bar color at half opacity, so the wallpaper shows through.
+ * - `transparent`: no background at all; only the wallpaper behind the buttons and tray.
+ *
+ * Unset (or any other value) keeps the stock background, and so does every app: in apps the bar
+ * looks the way it always has.
+ */
+class RetroBarBackground(private val context: TaskbarActivityContext) {
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    private val barColor = context.getColor(R.color.taskbar_background)
+    private var gradientHeight = -1f
+
+    /**
+     * Draws the home screen background into the bottom [height] pixels of [canvas], at
+     * [alpha] (0 to 255, the stock background's current alpha). Returns false when the stock
+     * background should be drawn instead.
+     */
+    fun draw(canvas: Canvas, height: Float, alpha: Int): Boolean {
+        val mode = mode ?: return false
+        if (context.controllers.taskbarStashController.isInApp) return false
+        if (mode == MODE_TRANSPARENT || height <= 0f || alpha == 0) return true
+        val top = canvas.height - height
+        when (mode) {
+            MODE_SOLID -> {
+                paint.shader = null
+                paint.color = withAlpha(barColor, 255)
+            }
+            MODE_TRANSLUCENT -> {
+                paint.shader = null
+                paint.color = withAlpha(barColor, TRANSLUCENT_ALPHA)
+            }
+            else -> {
+                if (gradientHeight != height || paint.shader == null) {
+                    gradientHeight = height
+                    paint.shader =
+                        LinearGradient(
+                            0f,
+                            top,
+                            0f,
+                            canvas.height.toFloat(),
+                            Color.TRANSPARENT,
+                            withAlpha(Color.BLACK, GRADIENT_ALPHA),
+                            Shader.TileMode.CLAMP,
+                        )
+                }
+                paint.color = Color.BLACK
+            }
+        }
+        paint.alpha = paint.alpha * alpha / 255
+        canvas.drawRect(0f, top, canvas.width.toFloat(), canvas.height.toFloat(), paint)
+        return true
+    }
+
+    private fun withAlpha(color: Int, alpha: Int) = (color and 0x00FFFFFF) or (alpha shl 24)
+
+    companion object {
+        const val MODE_SOLID = "solid"
+        const val MODE_GRADIENT = "gradient"
+        const val MODE_TRANSLUCENT = "translucent"
+        const val MODE_TRANSPARENT = "transparent"
+        private val MODES = setOf(MODE_SOLID, MODE_GRADIENT, MODE_TRANSLUCENT, MODE_TRANSPARENT)
+
+        private const val TRANSLUCENT_ALPHA = 0x80
+        private const val GRADIENT_ALPHA = 0xB3
+
+        /** The home screen background mode, or null for the stock one. */
+        @JvmStatic
+        val mode: String? by lazy {
+            RetroUiApplied["bar_background"]?.takeIf { RetroSystemBar.isEnabled && it in MODES }
+        }
+
+        /** Whether the system bar draws its own home screen background. */
+        @JvmStatic val isActive: Boolean get() = mode != null
+    }
+}
