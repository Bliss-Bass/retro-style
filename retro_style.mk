#
# vendor/retro-style: theme packs from every Android era (themes/<id>/) and the tablet
# system bar for large-screen Android 16 / LineageOS 23.2 builds.
#
# Use it from your device (or product) makefile:
#
#   # Optional build settings, set BEFORE the inherit line:
#   RETRO_STYLE_TYPE := kitkat          # default pack: any id in themes/ (default: material;
#                                       # materialyou means material)
#   RETRO_STYLE_LAYOUT := system_bar    # stock | system_bar (default: what the pack suggests)
#   RETRO_STYLE_THEMES := material m3 kitkat   # packs to ship (default: all of them)
#   $(call inherit-product, vendor/retro-style/retro_style.mk)
#
# The defaults only apply until the user picks something in Settings > System > UI style.
# The frameworks/base and Launcher3 patches must be applied too: see docs/INSTALL.md.
#

RETRO_STYLE_DIR := vendor/retro-style

# RETRO_THEMES_ALL and RETRO_THEME_LAYOUT_<id>, generated by tools/theme_tool.py.
include $(RETRO_STYLE_DIR)/themes/themes.mk

# --- Build defaults ----------------------------------------------------------------------------

ifeq ($(RETRO_STYLE_TYPE),)
RETRO_STYLE_TYPE := material
endif
ifeq ($(RETRO_STYLE_TYPE),materialyou)
RETRO_STYLE_TYPE := material
endif

ifeq ($(RETRO_STYLE_THEMES),)
RETRO_STYLE_THEMES := $(RETRO_THEMES_ALL)
endif
ifneq ($(filter-out $(RETRO_THEMES_ALL),$(RETRO_STYLE_THEMES)),)
$(error RETRO_STYLE_THEMES has packs that aren't in $(RETRO_STYLE_DIR)/themes: $(filter-out $(RETRO_THEMES_ALL),$(RETRO_STYLE_THEMES)))
endif
ifeq ($(filter $(RETRO_STYLE_TYPE),$(RETRO_STYLE_THEMES)),)
$(error RETRO_STYLE_TYPE must be one of the packs you ship: $(RETRO_STYLE_THEMES) (got '$(RETRO_STYLE_TYPE)'))
endif
RETRO_UI_STYLE_DEFAULT := $(RETRO_STYLE_TYPE)

# The tablet system bar comes with packs that suggest it (shell.layout), unless the device asks
# for the stock taskbar.
ifeq ($(RETRO_STYLE_LAYOUT),)
RETRO_STYLE_LAYOUT := $(RETRO_THEME_LAYOUT_$(RETRO_UI_STYLE_DEFAULT))
endif
ifeq ($(filter stock system_bar,$(RETRO_STYLE_LAYOUT)),)
$(error RETRO_STYLE_LAYOUT must be stock or system_bar (got '$(RETRO_STYLE_LAYOUT)'))
endif

# Read-only properties in /system_ext/build.prop. The RetroStyle app reads them; any app may
# read an ro.* property, and nothing writes them.
PRODUCT_SYSTEM_EXT_PROPERTIES += \
    ro.retro.ui_style.default=$(RETRO_UI_STYLE_DEFAULT) \
    ro.retro.ui_layout.default=$(RETRO_STYLE_LAYOUT)

# --- The Settings page and the code that applies the style ------------------------------------

PRODUCT_PACKAGES += \
    RetroStyle

# --- Theme packs (themes/<id>/Android.bp) ------------------------------------------------------

# One phony module per pack pulls in its theme.json and overlays. RetroStyle switches the
# org.retro.theme overlays; SystemUI applies the font and icon packs from the theme JSON
# RetroStyle writes.
PRODUCT_PACKAGES += \
    $(addprefix RetroTheme_,$(RETRO_STYLE_THEMES))

# --- Layout overlays (overlays/<Name>/Android.bp) ---------------------------------------------

# Tablet system bar: hides the top status bar when the tray shows the status icons.
PRODUCT_PACKAGES += \
    RetroStyleSystemBarFramework

# Dual Shade layout for SystemUI (always on).
PRODUCT_PACKAGES += \
    RetroStyleDualShadeSystemUI

# --- Dual Shade aconfig flags (config/aconfig) -------------------------------------------------

PRODUCT_RELEASE_CONFIG_MAPS += \
    $(RETRO_STYLE_DIR)/config/aconfig/release_config_map.textproto
