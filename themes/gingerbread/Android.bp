// Generated by tools/theme_tool.py from theme.json; do not edit.

package {
    default_applicable_licenses: ["vendor_retro-style_license"],
}

// Gingerbread: Android 2.3 (2010): the classic widgets on pure black with Gingerbread green, square corners.
// Add this one module to PRODUCT_PACKAGES (retro_style.mk does, through themes.mk).
phony {
    name: "RetroTheme_gingerbread",
    required: [
        "RetroTheme_gingerbread_json",
        "RetroTheme_gingerbread_android",
        "RetroTheme_gingerbread_systemui",
        "RetroTheme_gingerbread_settings",
        "RetroTheme_gingerbread_launcher3",
    ],
}

// The RetroStyle app lists the packs it finds in /product/etc/retro-style/themes.
prebuilt_etc {
    name: "RetroTheme_gingerbread_json",
    src: "theme.json",
    filename: "gingerbread.json",
    sub_dir: "retro-style/themes",
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_gingerbread_android",
    resource_dirs: ["android/res_gen"],
    manifest: "android/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_gingerbread_systemui",
    resource_dirs: ["systemui/res_gen"],
    manifest: "systemui/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_gingerbread_settings",
    resource_dirs: ["settings/res_gen"],
    manifest: "settings/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_gingerbread_launcher3",
    resource_dirs: ["launcher3/res_gen"],
    manifest: "launcher3/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}
