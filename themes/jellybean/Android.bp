// Generated by tools/theme_tool.py from theme.json; do not edit.

package {
    default_applicable_licenses: ["vendor_retro-style_aosp_assets_license"],
}

// Jelly Bean: Android 4.0 to 4.3 (2011 to 2013): black and grey Holo Dark, Holo blue status icons and the Jelly Bean tablet glyphs on the system bar.
// Add this one module to PRODUCT_PACKAGES (retro_style.mk does, through themes.mk).
phony {
    name: "RetroTheme_jellybean",
    required: [
        "RetroTheme_jellybean_json",
        "RetroTheme_jellybean_android",
        "RetroTheme_jellybean_systemui",
        "RetroTheme_jellybean_settings",
        "RetroTheme_jellybean_launcher3",
        "RetroTheme_jellybean_font",
        "RetroTheme_jellybean_icons_android",
        "RetroTheme_jellybean_icons_systemui",
    ],
}

// The RetroStyle app lists the packs it finds in /product/etc/retro-style/themes.
prebuilt_etc {
    name: "RetroTheme_jellybean_json",
    src: "theme.json",
    filename: "jellybean.json",
    sub_dir: "retro-style/themes",
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_jellybean_android",
    resource_dirs: ["android/res_gen"],
    manifest: "android/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_jellybean_systemui",
    resource_dirs: ["systemui/res_gen"],
    manifest: "systemui/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_jellybean_settings",
    resource_dirs: ["settings/res_gen"],
    manifest: "settings/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_jellybean_launcher3",
    resource_dirs: ["launcher3/res", "launcher3/res_gen"],
    // aapt2 links the second folder as an overlay of the first; let it add the
    // names the first one doesn't have.
    aaptflags: ["--auto-add-overlay"],
    manifest: "launcher3/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_jellybean_font",
    resource_dirs: ["font/res_gen"],
    manifest: "font/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_jellybean_icons_android",
    resource_dirs: ["icons_android/res"],
    manifest: "icons_android/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}

runtime_resource_overlay {
    name: "RetroTheme_jellybean_icons_systemui",
    resource_dirs: ["icons_systemui/res"],
    manifest: "icons_systemui/AndroidManifest.xml",
    // /product overlays may replace resources of targets without <overlayable>.
    product_specific: true,
}
